{
  "name": "jokebylemans",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "content:pull": "areca pull",
    "content:build": "node scripts/build-content.mjs",
    "generate:seo": "node scripts/generate-seo-pages.mjs",
    "build": "npm run content:pull && npm run content:build && npm run generate:seo && vue-tsc -b && vite build",
    "build:offline": "npm run generate:seo && vue-tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@areca-cms/site-sdk": "^0.11.1",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/chewy": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "aos": "^2.3.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/aos": "^3.0.7",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "vite": "^7.3.6",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.2.6",
    "wrangler": "^4.166.0"
  }
}
